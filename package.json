{
  "name": "easyplex-dev-tools",
  "private": true,
  "description": "Checks and tests for the EasyPlex web UI (not shipped in the APK).",
  "type": "module",
  "scripts": {
    "lint": "eslint web/js tests",
    "test": "node --test tests/unit.test.mjs tests/livetv.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "ci": "npm run lint && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.0",
    "globals": "^15.15.0",
    "jsdom": "^24.1.3",
    "playwright": "1.63.0"
  }
}
