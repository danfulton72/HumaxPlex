<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="EasyPlex" android:icon="@drawable/easyplex_logo" android:roundIcon="@drawable/easyplex_logo" android:banner="@drawable/easyplex_tv_banner" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="true" android:hardwareAccelerated="true">
        <activity android:banner="@drawable/easyplex_tv_banner" android:icon="@drawable/easyplex_logo" android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
